{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(~/.aws/**)",
      "Read(./infra/**/*.tfstate)",
      "Read(./infra/**/*.tfstate.*)"
    ],
    "ask": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(aws:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(uv add:*)",
      "Bash(npm install:*)",
      "Bash(uv run pytest -m s3:*)",
      "Edit(./backend/**/migrations/**)"
    ]
  }
}
